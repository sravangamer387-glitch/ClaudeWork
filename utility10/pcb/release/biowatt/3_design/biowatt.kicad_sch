) (rectangle (start 20 200.8) (end 241.6 341.66) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 1c1201b3-4816-4dad-ae55-fb1b3d3d78df)) (text "HIGH-IMPEDANCE SETTING DIVIDERS (no ground pour nearby): VBAT_OV, VBAT_OK / hysteresis, VOUT" (at 21.5 203.8 0) (effects (font (size 2 2) bold) (justify left)) (uuid 2ff9af08-0002-4422-bf5d-bc36485124d0)) (text "BioWatt: BQ25570 values per the TI datasheet (SLUSBH2G) equations. VBAT_OV = 1.5 * VBIAS * (1 + ROV2/ROV1)" (at 20 349.66 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid a973a3f6-0840-413c-a01f-02cd1f4419ef)) (text "with VBIAS = 1.21 V: ROV1 = 5.6 M, ROV2 = 5.6 M + 1 M gives 3.95 V (cell charged to about 3.95 V). VBAT_OK =" (at 20 353.06 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 4e422bf4-2c26-4a28-b0fc-2e5c178311a1)) (text "VBIAS * (1 + ROK2/ROK1): ROK1 = 4.3 M, ROK2 = 5.6 M + 1 M + 1 M gives 3.35 V falling; VBAT_OK_HYST = VBIAS *" (at 20 356.46 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 3cf8ea72-1b3e-4842-8390-3c979008194f)) (text "(1 + (ROK2 + ROK3)/ROK1) with ROK3 = 1 M gives 3.63 V rising. VOUT = VBIAS * (1 + ROUT2/ROUT1): ROUT1 = 4.3 M," (at 20 359.86 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 790674d8-0e43-463b-a99f-03eb4288adfd)) (text "ROUT2 = 5.6 M + 1 M + 1 M gives 3.35 V. Each divider sum is at most 13 M as the datasheet recommends. Use a" (at 20 363.26 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 2630ea7f-a874-4f7c-9143-ade2eb7d179c)) (text "PROTECTED single Li-ion/LiPo cell. Clean flux residue thoroughly: the dividers are megohm-level." (at 20 366.66 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 8295a598-4045-43e2-993c-00a265c9805b)) (sheet_instances (path "/" (page "1"))))