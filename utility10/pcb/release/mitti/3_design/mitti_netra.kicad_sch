id e415ca9f-e54b-4663-9ea4-ba588b47994b)) (rectangle (start 20 22) (end 186 271.34) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid dd34f1ec-74f0-410d-8313-42266d4792f3)) (text "CHARGER: solar + USB, TP4056, Li-ion cell, 3.3 V LDO" (at 21.5 25 0) (effects (font (size 2 2) bold) (justify left)) (uuid e24730e9-94e9-40e4-bcd7-83d12cf809e8)) (rectangle (start 192 22) (end 355.94 279.22) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid c89f86e6-691e-43e4-b11a-1559260d3a03)) (text "CONTROLLER: ESP32-S3 (deep sleep between reports), USB-C" (at 193.5 25 0) (effects (font (size 2 2) bold) (justify left)) (uuid e201d3e0-6e5c-4065-b300-1478e1e9a1ca)) (rectangle (start 361.94 22) (end 521.94 131.78) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 4318f9a8-5b05-473b-a4c6-3489fb49ff04)) (text "CELLULAR MODEM SOCKET: high-side switch, burst capacitors, UART" (at 363.44 25 0) (effects (font (size 2 2) bold) (justify left)) (uuid 186fd93f-07e4-4758-ad9a-bbc901d4fb64)) (rectangle (start 527.94 22) (end 724.24 280.9) (stroke (width 0.2) (type dash)) (fill (type none)) (uuid 38b75dce-d3d6-4e15-b6d3-163c852d6871)) (text "SENSORS: tilt/vibration (ADXL345), strain bridge (HX711), soil probe, temperature" (at 529.44 25 0) (effects (font (size 2 2) bold) (justify left)) (uuid 1835832e-f585-417e-a1ff-6e029e7044d5)) (text "MITTI-NETRA: solar/USB charge a protected 1S Li-ion cell through a TP4056 (charge current about 0.58 A with R1" (at 20 288.9 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid d421e212-6def-4d05-abba-d51cc966d237)) (text "= 2.2 k). The ESP32-S3 deep-sleeps and reports through a plug-in SIM7080G breakout (LTE-M / NB-IoT) that is" (at 20 292.3 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 8a96087c-40ae-4575-bd83-db2e58e91c89)) (text "powered through the high-side switch Q1 only while transmitting; the socket brings out VBAT, GND, UART and" (at 20 295.7 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 1b6b9dcc-9522-498e-af7a-e27b484353b7)) (text "PWRKEY/STATUS: match your breakout's pinout. ADXL345 on I2C gives tilt and vibration; HX711 reads a strain-" (at 20 299.1 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 8c61ce4e-bb3e-431b-8b12-db5b81f4c343)) (text "gauge bridge; capacitive soil probe on an ADC pin; DS18B20 temperature on 1-Wire. Charge temperature window:" (at 20 302.5 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 96029e48-a662-44e3-a56e-104f551eb26e)) (text "R16 6.2 k from VCC to TEMP and the 10 k B3950 NTC TH1 to GND hold TEMP between 45 % and 80 % of VCC only from" (at 20 305.9 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid 64f6a3d0-f9e5-4134-8620-0a70ed88f6c2)) (text "about 6 C to 44 C (TP4056 suspends charging outside); keep TH1 near the cell. LDO cutoff: the node stops" (at 20 309.3 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid c7731b7a-307b-4650-acbb-92c81bb3bff8)) (text "regulating below about 3.55 V on the cell." (at 20 312.7 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid b499c276-3640-4d8e-9068-2f0abe3087b0)) (sheet_instances (path "/" (page "1"))))